---
import SectionLabel from '../components/SectionLabel.astro';
import { EXPERIENCE_ROLES } from '../lib/content/profile';
---

<section id="experience" class="border-b-2 border-[#111111] bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionLabel index="06 // TRACK RECORD" title="ENGINEERING ROLES & SCOPE" />

    <div class="mb-10">
      <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#111111]">
        PROFESSIONAL CAPACITIES
      </h2>
      <p class="font-mono text-xs sm:text-sm text-[#111111]/70 mt-2">
        Factual scope of responsibilities, project execution domains, and system duties.
      </p>
    </div>

    <!-- Roles Grid -->
    <div class="space-y-6">
      {EXPERIENCE_ROLES.map((role, idx) => (
        <div class="border-2 border-[#111111] bg-[#FFFFFF] p-6 md:p-8 shadow-hard">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b-2 border-[#111111] pb-4 mb-6">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold px-2 py-0.5 bg-[#111111] text-[#F2F0EA]">
                ROLE 0{idx + 1}
              </span>
              <h3 class="text-xl md:text-2xl font-black uppercase tracking-tight text-[#111111]">
                {role.title}
              </h3>
            </div>
            <span class="font-mono text-xs font-bold px-2 py-0.5 bg-[#0057FF] text-[#FFFFFF] self-start md:self-auto">
              {role.category}
            </span>
          </div>

          <p class="font-mono text-sm text-[#111111]/90 mb-6 leading-relaxed">
            {role.summary}
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-[#111111]/20">
            <!-- Left: Scope -->
            <div>
              <div class="font-mono text-xs font-bold uppercase text-[#0057FF] mb-3">
                // SYSTEM RESPONSIBILITIES
              </div>
              <ul class="space-y-1.5 font-mono text-xs text-[#111111]/85">
                {role.scope.map((s) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#0057FF] font-bold">›</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Right: Tech Stack -->
            <div>
              <div class="font-mono text-xs font-bold uppercase text-[#111111] mb-3">
                // ACTIVE TECHNOLOGIES
              </div>
              <div class="flex flex-wrap gap-2">
                {role.technologies.map((t) => (
                  <span class="font-mono text-xs px-2 py-1 border border-[#111111] bg-[#F2F0EA] text-[#111111] font-semibold">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

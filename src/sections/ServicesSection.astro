---
import SectionLabel from '../components/SectionLabel.astro';
import { SERVICES_LIST } from '../lib/content/profile';
---

<section id="services" class="border-b-2 border-[#111111] bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionLabel index="07 // ENGAGEMENT" title="EDITORIAL SERVICES LIST" />

    <div class="mb-10">
      <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#111111]">
        TECHNICAL DELIVERABLES
      </h2>
      <p class="font-mono text-xs sm:text-sm text-[#111111]/70 mt-2">
        Direct engineering services without marketing fluff or generic retainer tiers.
      </p>
    </div>

    <!-- Editorial Service List -->
    <div class="border-2 border-[#111111] bg-[#FFFFFF] shadow-hard divide-y-2 divide-[#111111]">
      {SERVICES_LIST.map((srv) => (
        <div class="p-6 md:p-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6 hover:bg-[#F2F0EA]/50 transition-colors">
          <div class="lg:w-1/3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm font-black px-2 py-0.5 bg-[#0057FF] text-[#FFFFFF]">
                {srv.id}
              </span>
              <h3 class="text-lg md:text-xl font-bold uppercase tracking-tight text-[#111111]">
                {srv.title}
              </h3>
            </div>
          </div>

          <div class="lg:w-1/3 font-mono text-xs md:text-sm text-[#111111]/80 leading-relaxed">
            {srv.description}
          </div>

          <div class="lg:w-1/3 font-mono text-xs space-y-1">
            <div class="text-[#0057FF] font-bold uppercase mb-1">// DELIVERABLES</div>
            {srv.deliverables.map((d) => (
              <div class="text-[#111111]/90 flex items-center gap-1.5">
                <span>▪</span> {d}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import SectionLabel from '../components/SectionLabel.astro';

const expertiseCards = [
  {
    num: '01',
    title: 'WEB DEVELOPMENT',
    desc: 'WordPress, Elementor Pro, WooCommerce, Astro and modern responsive websites engineered for speed and conversion.',
    tags: ['Astro', 'TypeScript', 'WordPress', 'WooCommerce', 'Tailwind']
  },
  {
    num: '02',
    title: 'LARAVEL / BACKEND',
    desc: 'Laravel, PHP, Blade, Livewire, robust REST APIs, authentication and business applications.',
    tags: ['Laravel', 'PHP', 'Livewire', 'Sanctum', 'Spatie', 'MySQL']
  },
  {
    num: '03',
    title: 'INFRASTRUCTURE',
    desc: 'Linux, VPS, Nginx, LiteSpeed, Docker, Traefik and Proxmox hypervisor administration.',
    tags: ['Linux', 'VPS', 'Nginx', 'LiteSpeed', 'Docker', 'Proxmox']
  },
  {
    num: '04',
    title: 'CLOUD / DEPLOYMENT',
    desc: 'Cloudflare Workers, DNS routing, SSL certificates, reverse proxy and production edge deployment.',
    tags: ['Cloudflare Workers', 'DNS', 'SSL', 'Reverse Proxy', 'CDN']
  },
  {
    num: '05',
    title: 'NETWORKING',
    desc: 'TCP/IP, DNS, DHCP, NAT, IPv4, IPv6, firewall policies, VLANs and MikroTik configurations.',
    tags: ['MikroTik', 'Tailscale', 'Firewall', 'TCP/IP', 'VLAN']
  },
  {
    num: '06',
    title: 'PERFORMANCE',
    desc: 'Technical SEO, caching strategies, Core Web Vitals remediation and infrastructure optimization.',
    tags: ['LiteSpeed Cache', 'Core Web Vitals', 'Yoast SEO', 'Server Tuning']
  }
];
---

<section id="expertise" class="border-b-2 border-[#111111] bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionLabel index="02 // CAPABILITIES" title="ENGINEERING EXPERTISE" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {expertiseCards.map((card) => (
        <div class="border-2 border-[#111111] bg-[#FFFFFF] p-6 shadow-hard-interactive flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b-2 border-[#111111] pb-3">
              <span class="font-mono text-xl font-black px-2 py-0.5 bg-[#111111] text-[#F2F0EA] group-hover:bg-[#0057FF] group-hover:text-[#FFFFFF] transition-colors">
                {card.num}
              </span>
              <span class="font-mono text-[10px] text-[#111111]/60 uppercase tracking-widest">
                VERIFIED DOMAIN
              </span>
            </div>

            <h3 class="text-xl font-bold uppercase tracking-tight text-[#111111]">
              {card.title}
            </h3>

            <p class="font-mono text-xs sm:text-sm text-[#111111]/80 leading-relaxed">
              {card.desc}
            </p>
          </div>

          <!-- Tags -->
          <div class="pt-4 border-t-2 border-[#111111]/10 flex flex-wrap gap-1.5">
            {card.tags.map((tag) => (
              <span class="font-mono text-[10px] px-2 py-0.5 border border-[#111111] bg-[#F2F0EA] text-[#111111] font-semibold">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import SectionLabel from '../components/SectionLabel.astro';

const expertiseCards = [
  {
    num: '01',
    title: 'WEB DEVELOPMENT',
    desc: 'I build websites and web applications with Astro, WordPress, and Laravel, depending on the project.',
    tags: ['Astro', 'TypeScript', 'Tailwind CSS', 'HTML', 'JavaScript']
  },
  {
    num: '02',
    title: 'WORDPRESS',
    desc: 'WordPress websites, Elementor builds, WooCommerce setup, customisation, and ongoing maintenance.',
    tags: ['WordPress', 'Elementor Pro', 'WooCommerce', 'Gutenberg', 'LiteSpeed Cache']
  },
  {
    num: '03',
    title: 'LARAVEL / BACKEND',
    desc: 'PHP and Laravel applications, REST APIs, authentication, and database-backed features.',
    tags: ['Laravel', 'PHP', 'Blade', 'Livewire', 'MySQL', 'REST API']
  },
  {
    num: '04',
    title: 'LINUX / SERVER',
    desc: 'VPS setup and maintenance, web server configuration, Docker, and reverse proxies.',
    tags: ['Linux', 'Nginx', 'LiteSpeed', 'Docker', 'Traefik', 'Proxmox']
  },
  {
    num: '05',
    title: 'IT INFRASTRUCTURE',
    desc: 'Network and server projects, including MikroTik, CCTV/NVR, NAS, and UPS planning.',
    tags: ['MikroTik', 'Tailscale', 'CCTV / NVR', 'NAS', 'UPS']
  },
  {
    num: '06',
    title: 'PROJECT ESTIMATION',
    desc: 'BOQ/RAB, equipment selection, technical specifications, and power-load calculations.',
    tags: ['BOQ / RAB', 'Hardware Sizing', 'Technical Specs', 'Power Load']
  }
];
---

<section id="expertise" class="border-b-2 border-[#111111] bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionLabel index="02 // CAPABILITIES" title="AREAS OF WORK" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {expertiseCards.map((card) => (
        <div class="border-2 border-[#111111] bg-[#FFFFFF] p-6 shadow-hard-interactive flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b-2 border-[#111111] pb-3">
              <span class="font-mono text-xl font-black px-2 py-0.5 bg-[#111111] text-[#F2F0EA] group-hover:bg-[#0057FF] group-hover:text-[#FFFFFF] transition-colors">
                {card.num}
              </span>
            </div>

            <h3 class="text-xl font-bold uppercase tracking-tight text-[#111111]">
              {card.title}
            </h3>

            <p class="font-mono text-xs sm:text-sm text-[#111111]/80 leading-relaxed">
              {card.desc}
            </p>
          </div>

          <!-- Tags -->
          <div class="pt-4 border-t-2 border-[#111111]/10 flex flex-wrap gap-1.5">
            {card.tags.map((tag) => (
              <span class="font-mono text-[10px] px-2 py-0.5 border border-[#111111] bg-[#F2F0EA] text-[#111111] font-semibold">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

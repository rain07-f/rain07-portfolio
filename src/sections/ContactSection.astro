---
import SectionLabel from "../components/SectionLabel.astro";
import BrutalistButton from "../components/BrutalistButton.astro";

const email = "reyno.fahreza@gmail.com";
const linkedIn = "https://www.linkedin.com/in/reyno-nur-fahreza-85908999/";
const whatsapp = "https://wa.me/6282243856452";
---

<section id="contact" class="section-deferred bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionLabel index="09 // CONTACT" title="CONTACT" />

    <div
      class="border-2 border-[#111111] bg-[#FFFFFF] p-8 md:p-16 shadow-hard-lg"
    >
      <div class="max-w-3xl space-y-6 mb-12">
        <h2
          class="text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-tight text-[#111111] leading-[0.95]"
        >
          LET'S TALK.
        </h2>
        <p
          class="font-mono text-sm md:text-base text-[#111111]/85 leading-relaxed"
        >
          Open to web development, WordPress, Laravel, infrastructure, and technical project work.
        </p>
      </div>

      <!-- Large Brutalist Contact Buttons Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <BrutalistButton
          href={`mailto:${email}`}
          variant="primary"
          class="!py-6 !text-sm md:!text-base flex-col gap-1 items-start !px-6"
        >
          <span class="text-[10px] text-[#0057FF] opacity-90"
            >// ELECTRONIC MAIL</span
          >
          <span class="font-bold">EMAIL →</span>
          <span class="text-[11px] lowercase opacity-80 truncate w-full"
            >{email}</span
          >
        </BrutalistButton>

        <BrutalistButton
          href={linkedIn}
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          class="!py-6 !text-sm md:!text-base flex-col gap-1 items-start !px-6"
        >
          <span class="text-[10px] text-[#0057FF] opacity-90"
            >// PROFESSIONAL NETWORK</span
          >
          <span class="font-bold">LINKEDIN →</span>
          <span class="text-[11px] opacity-80">Reyno Nur Fahreza</span>
        </BrutalistButton>

        <BrutalistButton
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          variant="accent"
          class="!py-6 !text-sm md:!text-base flex-col gap-1 items-start !px-6"
        >
          <span class="text-[10px] text-[#FFFFFF] opacity-90"
            >// INSTANT MESSAGING</span
          >
          <span class="font-bold">WHATSAPP →</span>
          <span class="text-[11px] opacity-90">Direct Chat</span>
        </BrutalistButton>
      </div>

      <!-- Security Notice -->
      <div
        class="mt-12 pt-6 border-t-2 border-[#111111]/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-xs text-[#111111]/60"
      >
        <div>RAIN07 / REYNO07</div>
        <div>- - -</div>
      </div>
    </div>
  </div>
</section>

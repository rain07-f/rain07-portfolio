---
import SectionLabel from '../components/SectionLabel.astro';
import BlogCard from '../components/BlogCard.astro';
import BrutalistButton from '../components/BrutalistButton.astro';
import { getPosts } from '../lib/api/client';

const posts = await getPosts();
---

<section id="notes" class="section-deferred border-b-2 border-[#111111] bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionLabel index="08 // TECHNICAL NOTES" title="TECHNICAL NOTES" />

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#111111]">
          TECHNICAL NOTES
        </h2>
        <p class="font-mono text-xs sm:text-sm text-[#111111]/75 mt-2">
          Synced live from standard WordPress Posts.
        </p>
      </div>

      <BrutalistButton href="/notes" variant="secondary">
        VIEW ALL NOTES ({posts.length}) →
      </BrutalistButton>
    </div>

    <!-- Blog Posts Grid -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.slice(0, 3).map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    ) : (
      <div class="border-2 border-[#111111] bg-[#FFFFFF] p-8 md:p-12 shadow-hard font-mono text-sm space-y-3">
        <div class="flex items-center gap-2">
          <span class="bg-[#111111] text-[#F2F0EA] px-2 py-0.5 text-xs font-bold">STATUS: EMPTY</span>
          <span class="text-[#0057FF] font-bold text-xs uppercase">// TECHNICAL NOTES</span>
        </div>
        <div class="text-base font-bold text-[#111111] uppercase tracking-tight">
          NO TECHNICAL NOTES YET
        </div>
        <p class="text-xs md:text-sm text-[#111111]/80 max-w-xl leading-relaxed">
          The technical journal is currently empty. New articles will appear here as I publish notes on web development, WordPress, Linux, and IT infrastructure.
        </p>
      </div>
    )}
  </div>
</section>

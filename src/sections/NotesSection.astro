---
import SectionLabel from '../components/SectionLabel.astro';
import BlogCard from '../components/BlogCard.astro';
import BrutalistButton from '../components/BrutalistButton.astro';
import { getPosts } from '../lib/api/client';

const posts = await getPosts();
---

<section id="notes" class="border-b-2 border-[#111111] bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionLabel index="08 // JOURNAL" title="TECHNICAL NOTES" />

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#111111]">
          ENGINEERING ARCHIVE
        </h2>
        <p class="font-mono text-xs sm:text-sm text-[#111111]/75 mt-2">
          Synced live from standard WordPress Posts.
        </p>
      </div>

      <BrutalistButton href="/notes" variant="secondary">
        VIEW ALL NOTES ({posts.length}) →
      </BrutalistButton>
    </div>

    <!-- Blog Posts Grid -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.slice(0, 3).map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    ) : (
      <div class="border-2 border-[#111111] bg-[#FFFFFF] p-12 text-center shadow-hard font-mono text-sm text-[#111111]/70">
        [ NO NOTES IN BACKEND REPOSITORY ]
      </div>
    )}
  </div>
</section>

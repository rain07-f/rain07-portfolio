---
import type { NormalizedPortfolioItem } from '../lib/api/types';
import BrutalistButton from './BrutalistButton.astro';

interface Props {
  project: NormalizedPortfolioItem;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article class={`border-2 border-[#111111] bg-[#FFFFFF] shadow-hard flex flex-col justify-between group transition-transform duration-100 ${featured ? 'md:col-span-2' : ''}`}>
  <!-- Top meta bar -->
  <div class="flex items-center justify-between border-b-2 border-[#111111] bg-[#F2F0EA] px-4 py-2 font-mono text-xs">
    <div class="flex items-center gap-2">
      <span class="font-bold text-[#111111]">ID: #{project.id}</span>
      {project.categories.length > 0 && (
        <span class="bg-[#111111] text-[#F2F0EA] px-1.5 py-0.5 text-[10px] uppercase font-semibold">
          {project.categories[0].name}
        </span>
      )}
    </div>
    <span class={`font-bold px-2 py-0.5 text-[10px] border border-[#111111] ${
      project.statusBadge === 'CLIENT' ? 'bg-[#D9FF00] text-[#111111]' :
      project.statusBadge === 'LIVE' ? 'bg-[#0057FF] text-[#FFFFFF]' :
      'bg-[#111111] text-[#F2F0EA]'
    }`}>
      [{project.statusBadge}]
    </span>
  </div>

  <!-- Preview Image (if any) -->
  {project.featuredImage ? (
    <div class="relative overflow-hidden border-b-2 border-[#111111] bg-[#111111] aspect-[16/9] flex items-center justify-center">
      <img
        src={project.featuredImage.url}
        alt={project.featuredImage.alt}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
      />
      <div class="absolute bottom-2 left-2 bg-[#111111] text-[#F2F0EA] font-mono text-[10px] px-2 py-0.5 opacity-90">
        SOURCE: WORDPRESS CPT // {project.slug}
      </div>
    </div>
  ) : (
    <div class="aspect-[16/9] bg-[#F2F0EA] border-b-2 border-[#111111] flex items-center justify-center p-6 text-center font-mono text-xs text-[#111111]/60 grid-blueprint">
      <span>[ NO PREVIEW THUMBNAIL REGISTERED ]</span>
    </div>
  )}

  <!-- Project Info -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-2">
      <h3 class="text-xl md:text-2xl font-bold tracking-tight text-[#111111] group-hover:text-[#0057FF] transition-colors">
        <a href={`/work/${project.slug}`}>
          {project.title}
        </a>
      </h3>
      {project.excerpt && (
        <p class="font-mono text-xs md:text-sm text-[#111111]/80 line-clamp-3 leading-relaxed">
          {project.excerpt}
        </p>
      )}
    </div>

    <!-- Action Bar -->
    <div class="pt-4 border-t-2 border-[#111111]/10 flex items-center justify-between">
      <span class="font-mono text-[11px] text-[#111111]/60">
        MODIFIED: {new Date(project.modified).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
      </span>
      <BrutalistButton href={`/work/${project.slug}`} variant="secondary" class="!px-3 !py-1.5 !text-xs">
        CASE STUDY →
      </BrutalistButton>
    </div>
  </div>
</article>

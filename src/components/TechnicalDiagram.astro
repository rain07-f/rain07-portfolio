---
const architectureNodes = [
  { step: '01', title: 'CLIENT / INTERNET', tech: 'HTTPS · DNS · IPv4 / IPv6', color: 'bg-[#111111] text-[#F2F0EA]' },
  { step: '02', title: 'EDGE / PROXY', tech: 'Cloudflare Workers · SSL · WAF · CDN Cache', color: 'bg-[#0057FF] text-[#FFFFFF]' },
  { step: '03', title: 'FIREWALL & ROUTING', tech: 'MikroTik Router · NAT · Port Rules · Tailscale Mesh', color: 'bg-[#111111] text-[#F2F0EA]' },
  { step: '04', title: 'VIRTUALIZATION & HOST', tech: 'Proxmox VE · Bare-Metal Linux Hypervisor · CloudPanel', color: 'bg-[#111111] text-[#F2F0EA]' },
  { step: '05', title: 'WEB & REVERSE PROXY', tech: 'Nginx · LiteSpeed Server · Traefik SSL Termination', color: 'bg-[#0057FF] text-[#FFFFFF]' },
  { step: '06', title: 'APP RUNTIME & API', tech: 'Astro SSG · Laravel Sanctum · Headless WordPress PHP 8', color: 'bg-[#111111] text-[#F2F0EA]' },
  { step: '07', title: 'DATA & STORAGE', tech: 'MySQL · MariaDB · PostgreSQL · Redis Cache · NAS Storage', color: 'bg-[#D9FF00] text-[#111111]' },
];
---

<div class="border-2 border-[#111111] bg-[#FFFFFF] p-6 md:p-8 shadow-hard">
  <div class="flex items-center justify-between border-b-2 border-[#111111] pb-4 mb-6">
    <div class="font-mono text-xs font-bold uppercase tracking-wider text-[#111111]">
      BLUEPRINT // PRODUCTION FLOW & TOPOLOGY
    </div>
    <span class="font-mono text-[10px] bg-[#0057FF] text-[#FFFFFF] px-2 py-0.5 font-bold">
      VERIFIED DEPLOYMENT
    </span>
  </div>

  <!-- Flow Items -->
  <div class="space-y-3">
    {architectureNodes.map((node, idx) => (
      <div class="flex flex-col md:flex-row md:items-center gap-3">
        <!-- Main box -->
        <div class={`flex-1 p-4 border-2 border-[#111111] shadow-hard-interactive flex flex-col sm:flex-row sm:items-center justify-between gap-2 ${node.color}`}>
          <div class="flex items-center gap-3">
            <span class="font-mono font-black text-sm px-2 py-0.5 border border-current">
              {node.step}
            </span>
            <span class="font-mono font-bold tracking-tight text-sm md:text-base">
              {node.title}
            </span>
          </div>
          <div class="font-mono text-xs font-medium tracking-tight opacity-90">
            {node.tech}
          </div>
        </div>

        {idx < architectureNodes.length - 1 && (
          <div class="hidden md:flex justify-center items-center text-[#111111] font-mono font-bold text-xs select-none">
            ↓
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- Footnote -->
  <div class="mt-6 pt-4 border-t-2 border-[#111111]/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 font-mono text-[11px] text-[#111111]/70">
    <div>LAYER: EDGE TO PHYSICAL METAL</div>
    <div>FAILOVER & ZERO DOWNTIME DESIGN</div>
  </div>
</div>

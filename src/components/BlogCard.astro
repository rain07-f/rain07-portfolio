---
import type { NormalizedPost } from '../lib/api/types';
import BrutalistButton from './BrutalistButton.astro';

interface Props {
  post: NormalizedPost;
}

const { post } = Astro.props;
---

<article class="border-2 border-[#111111] bg-[#FFFFFF] shadow-hard flex flex-col justify-between group">
  <!-- Top bar -->
  <div class="flex items-center justify-between border-b-2 border-[#111111] bg-[#F2F0EA] px-4 py-2 font-mono text-xs">
    <div class="flex items-center gap-2">
      <span class="font-bold text-[#111111]">POST #{post.id}</span>
      {post.categories.length > 0 && (
        <span class="bg-[#111111] text-[#F2F0EA] px-1.5 py-0.5 text-[10px] uppercase font-semibold">
          {post.categories[0].name}
        </span>
      )}
    </div>
    <span class="font-mono text-[10px] text-[#111111]/70">
      {new Date(post.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
    </span>
  </div>

  <!-- Featured Image if available -->
  {post.featuredImage && (
    <div class="relative overflow-hidden border-b-2 border-[#111111] aspect-[16/9] bg-[#111111]">
      <img
        src={post.featuredImage.url}
        alt={post.featuredImage.alt}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
      />
    </div>
  )}

  <!-- Post Body -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-2">
      <h3 class="text-xl md:text-2xl font-bold tracking-tight text-[#111111] group-hover:text-[#0057FF] transition-colors">
        <a href={`/notes/${post.slug}`}>
          {post.title}
        </a>
      </h3>
      {post.excerpt && (
        <p class="font-mono text-xs md:text-sm text-[#111111]/80 line-clamp-3 leading-relaxed">
          {post.excerpt}
        </p>
      )}
    </div>

    <!-- Bottom Read Button -->
    <div class="pt-4 border-t-2 border-[#111111]/10 flex items-center justify-between">
      <span class="font-mono text-[11px] text-[#111111]/60 uppercase">
        BY {post.authorName}
      </span>
      <BrutalistButton href={`/notes/${post.slug}`} variant="secondary" class="!px-3 !py-1.5 !text-xs">
        READ NOTE →
      </BrutalistButton>
    </div>
  </div>
</article>

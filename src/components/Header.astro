---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "WORK", href: "/work" },
  { label: "EXPERTISE", href: "/#expertise" },
  { label: "INFRASTRUCTURE", href: "/#infrastructure" },
  { label: "BLOGS", href: "/notes" },
  { label: "ABOUT", href: "/#about" },
  { label: "CONTACT", href: "/#contact" },
];
---

<header class="sticky top-0 z-50 bg-[#F2F0EA] border-b-2 border-[#111111]">
  <div class="max-w-7xl mx-auto px-4 md:px-8 flex items-stretch justify-between">
    <!-- Brand Mark -->
    <a
      href="/"
      class="flex items-center gap-2.5 py-2.5 pr-5 md:pr-6 border-r-0 md:border-r-2 border-[#111111] bg-transparent text-[#111111] hover:opacity-80 transition-opacity select-none group"
      id="nav-brand"
      aria-label="RAIN07 — Home"
    >
      <img
        src="/images/rain07-logo-360w.png"
        alt="Rain07 Logo"
        width="360"
        height="101"
        class="h-9 md:h-10 w-auto object-contain block"
        loading="eager"
        decoding="async"
      />
      <span
        class="text-[10px] font-mono px-1.5 py-0.5 bg-[#111111] text-[#F2F0EA] group-hover:bg-[#0057FF] group-hover:text-[#FFFFFF] font-bold transition-colors"
        >R07</span
      >
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-stretch flex-1 justify-end">
      {
        navItems.map((item, index) => {
          const isLast = index === navItems.length - 1;
          const isActive =
            currentPath === item.href ||
            (item.href !== "/" &&
              currentPath.startsWith(item.href) &&
              !item.href.includes("#"));
          return (
            <a
              href={item.href}
              class={`flex items-center font-mono text-xs lg:text-sm font-bold tracking-wider border-l-2 border-[#111111] transition-colors select-none ${
                isLast ? "pl-5 lg:pl-6 pr-0" : "px-5 lg:px-6"
              } py-4 ${
                isActive
                  ? "bg-[#0057FF] text-[#FFFFFF]"
                  : "bg-transparent text-[#111111] hover:bg-[#0057FF] hover:text-[#FFFFFF]"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-nav-toggle"
      class="flex md:hidden items-center justify-center py-4 pl-5 font-mono font-bold text-sm bg-transparent text-[#111111] border-l-0 hover:bg-transparent hover:text-[#0057FF] focus:bg-transparent active:bg-transparent transition-colors select-none"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
    >
      <!-- Hamburger Icon (Closed State Only) -->
      <span id="nav-toggle-icon" class="inline-flex items-center justify-center">
        <svg
          class="w-5 h-5 fill-current"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <rect y="3" width="20" height="2"></rect>
          <rect y="9" width="20" height="2"></rect>
          <rect y="15" width="20" height="2"></rect>
        </svg>
      </span>
      <!-- Close Text (Open State Only) -->
      <span id="nav-toggle-text" class="hidden font-mono text-xs sm:text-sm font-bold tracking-widest uppercase">CLOSE</span>
    </button>
  </div>

  <!-- Mobile Fullscreen Brutalist Drawer -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden fixed inset-0 top-[61px] bg-[#F2F0EA] z-40 border-t-2 border-[#111111] flex-col p-6 overflow-y-auto"
  >
    <div
      class="flex flex-col border-2 border-[#111111] shadow-hard divide-y-2 divide-[#111111] bg-[#FFFFFF]"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link font-mono text-lg font-bold p-4 text-[#111111] hover:bg-[#0057FF] hover:text-[#FFFFFF] transition-colors"
          >
            {item.label} →
          </a>
        ))
      }
    </div>
    <div
      class="mt-8 p-4 border-2 border-[#111111] bg-[#F2F0EA] font-mono text-xs space-y-1"
    >
      <div class="font-bold text-[#111111]">RAIN07 / REYNO07</div>
      <div class="text-[#111111] opacity-75">LOCATION: INDONESIA</div>
      <div class="text-[#0057FF] font-semibold">
        RUNTIME: CLOUDFLARE WORKERS
      </div>
    </div>
  </div>
</header>

<style>
  /* Guaranteed state-driven display rules overriding utility cascade */
  #mobile-nav-toggle[aria-expanded="true"] #nav-toggle-icon {
    display: none !important;
  }
  #mobile-nav-toggle[aria-expanded="true"] #nav-toggle-text {
    display: inline-flex !important;
  }
  #mobile-nav-toggle[aria-expanded="false"] #nav-toggle-icon {
    display: inline-flex !important;
  }
  #mobile-nav-toggle[aria-expanded="false"] #nav-toggle-text {
    display: none !important;
  }
</style>

<script>
  const toggleBtn = document.getElementById("mobile-nav-toggle");
  const menu = document.getElementById("mobile-nav-menu");
  const icon = document.getElementById("nav-toggle-icon");
  const text = document.getElementById("nav-toggle-text");
  const links = document.querySelectorAll(".mobile-nav-link");
  const header = document.querySelector("header");

  function openMenu() {
    if (!menu || !toggleBtn) return;
    if (header) {
      menu.style.top = `${header.offsetHeight}px`;
    }
    menu.classList.remove("hidden");
    menu.classList.add("flex");
    if (icon) icon.style.display = "none";
    if (text) text.style.display = "inline-flex";
    toggleBtn.setAttribute("aria-expanded", "true");
    toggleBtn.setAttribute("aria-label", "Close menu");
    document.body.classList.add("overflow-hidden");
  }

  function closeMenu() {
    if (!menu || !toggleBtn) return;
    menu.classList.add("hidden");
    menu.classList.remove("flex");
    if (icon) icon.style.display = "inline-flex";
    if (text) text.style.display = "none";
    toggleBtn.setAttribute("aria-expanded", "false");
    toggleBtn.setAttribute("aria-label", "Open menu");
    document.body.classList.remove("overflow-hidden");
  }

  toggleBtn?.addEventListener("click", () => {
    const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
    if (isExpanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  links.forEach((l) => {
    l.addEventListener("click", () => {
      closeMenu();
    });
  });

  // Close menu on backdrop click
  menu?.addEventListener("click", (e) => {
    if (e.target === menu) {
      closeMenu();
    }
  });

  // Close menu on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggleBtn?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggleBtn.focus();
    }
  });

  // Reset when viewport resizes to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && toggleBtn?.getAttribute("aria-expanded") === "true") {
      closeMenu();
    }
  });
</script>

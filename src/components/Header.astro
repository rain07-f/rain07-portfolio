---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "WORK", href: "/work" },
  { label: "EXPERTISE", href: "/#expertise" },
  { label: "BLOGS", href: "/notes" },
  { label: "ABOUT", href: "/#about" },
  { label: "CONTACT", href: "/#contact" },
];
---

<header class="sticky top-0 z-50 bg-[#F2F0EA] border-b-2 border-[#111111]">
  <div class="max-w-7xl mx-auto px-4 md:px-8 flex items-stretch justify-between">
    <!-- Brand Mark -->
    <a
      href="/"
      class="flex items-center gap-2.5 py-2.5 pr-5 md:pr-6 border-r-0 md:border-r-2 border-[#111111] bg-transparent text-[#111111] hover:opacity-80 transition-opacity select-none group"
      id="nav-brand"
      aria-label="RAIN07 — Home"
    >
      <img
        src="/images/rain07-logo-360w.png"
        alt="Rain07 Logo"
        width="360"
        height="101"
        class="h-9 md:h-10 w-auto object-contain block"
        loading="eager"
        decoding="async"
      />
      <span
        class="text-[10px] font-mono px-1.5 py-0.5 bg-[#111111] text-[#F2F0EA] group-hover:bg-[#0057FF] group-hover:text-[#FFFFFF] font-bold transition-colors"
        >R07</span
      >
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-stretch flex-1 justify-end">
      {
        navItems.map((item, index) => {
          const isLast = index === navItems.length - 1;
          const isActive =
            currentPath === item.href ||
            (item.href !== "/" &&
              currentPath.startsWith(item.href) &&
              !item.href.includes("#"));
          return (
            <a
              href={item.href}
              class={`flex items-center justify-center font-mono text-xs lg:text-sm font-bold tracking-wider border-l-2 border-[#111111] ${
                isLast ? "border-r-2 border-[#111111]" : ""
              } transition-colors select-none px-3.5 lg:px-5 xl:px-6 py-4 ${
                isActive
                  ? "bg-[#0057FF] text-[#FFFFFF]"
                  : "bg-transparent text-[#111111] hover:bg-[#0057FF] hover:text-[#FFFFFF]"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-nav-toggle"
      class="flex md:hidden items-center justify-center py-4 pl-5 font-mono font-bold text-sm bg-transparent text-[#111111] border-l-0 hover:bg-transparent hover:text-[#0057FF] focus:bg-transparent active:bg-transparent transition-colors select-none"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
    >
      <span class="relative flex items-center justify-center w-[52px] h-5 overflow-hidden">
        <!-- Hamburger Icon (Closed State) -->
        <span id="nav-toggle-icon" class="absolute inset-0 flex items-center justify-center">
          <svg
            class="w-5 h-5 fill-current"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <rect y="3" width="20" height="2"></rect>
            <rect y="9" width="20" height="2"></rect>
            <rect y="15" width="20" height="2"></rect>
          </svg>
        </span>
        <!-- Close Text (Open State) -->
        <span
          id="nav-toggle-text"
          class="absolute inset-0 flex items-center justify-center font-mono text-xs sm:text-sm font-bold tracking-widest uppercase"
        >
          CLOSE
        </span>
      </span>
    </button>
  </div>

  <!-- Mobile Fullscreen Brutalist Drawer -->
  <div
    id="mobile-nav-menu"
    class="flex md:hidden fixed inset-0 top-[61px] bg-[#F2F0EA] z-40 border-t-2 border-[#111111] flex-col p-6 overflow-y-auto"
    aria-hidden="true"
  >
    <div
      class="flex flex-col border-2 border-[#111111] shadow-hard divide-y-2 divide-[#111111] bg-[#FFFFFF]"
    >
      {
        navItems.map((item, index) => (
          <a
            href={item.href}
            class="mobile-nav-link font-mono text-lg font-bold p-4 text-[#111111] hover:bg-[#0057FF] hover:text-[#FFFFFF] transition-colors"
            style={`--link-index: ${index};`}
          >
            {item.label} →
          </a>
        ))
      }
    </div>
    <div
      id="mobile-nav-info"
      class="mt-8 p-4 border-2 border-[#111111] bg-[#F2F0EA] font-mono text-xs space-y-1"
      style={`--link-index: ${navItems.length};`}
    >
      <div class="font-bold text-[#111111]">RAIN07 / REYNO07</div>
      <div class="text-[#111111] opacity-75">LOCATION: INDONESIA</div>
      <div class="text-[#0057FF] font-semibold">
        RUNTIME: CLOUDFLARE WORKERS
      </div>
    </div>
  </div>
</header>

<style>
  /* 1. Hamburger to CLOSE Smooth Transition */
  #nav-toggle-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 180ms ease,
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 0s;
  }

  #nav-toggle-text {
    opacity: 0;
    transform: translateX(8px);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 200ms;
  }

  #mobile-nav-toggle[aria-expanded="true"] #nav-toggle-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 200ms;
  }

  #mobile-nav-toggle[aria-expanded="true"] #nav-toggle-text {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 180ms ease,
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 0s;
  }

  /* 2. Menu Panel Transition */
  #mobile-nav-menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition:
      opacity 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 220ms;
  }

  #mobile-nav-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 0s;
  }

  /* Desktop safeguard */
  @media (min-width: 768px) {
    #mobile-nav-menu {
      display: none !important;
    }
  }

  /* 3. Navigation Links Entrance Stagger */
  .mobile-nav-link,
  #mobile-nav-info {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 180ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #mobile-nav-menu.is-open .mobile-nav-link,
  #mobile-nav-menu.is-open #mobile-nav-info {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--link-index, 0) * 35ms + 40ms);
  }

  /* Snappy exit without stagger delays when closing */
  #mobile-nav-menu:not(.is-open) .mobile-nav-link,
  #mobile-nav-menu:not(.is-open) #mobile-nav-info {
    transition:
      opacity 140ms ease,
      transform 140ms ease;
    transition-delay: 0ms !important;
  }

  /* 4. Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    #nav-toggle-icon,
    #nav-toggle-text,
    #mobile-nav-toggle[aria-expanded="true"] #nav-toggle-icon,
    #mobile-nav-toggle[aria-expanded="true"] #nav-toggle-text,
    #mobile-nav-menu,
    #mobile-nav-menu.is-open,
    .mobile-nav-link,
    #mobile-nav-info,
    #mobile-nav-menu.is-open .mobile-nav-link,
    #mobile-nav-menu.is-open #mobile-nav-info {
      transition: none !important;
      animation: none !important;
      transform: none !important;
      transition-delay: 0ms !important;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById("mobile-nav-toggle");
  const menu = document.getElementById("mobile-nav-menu");
  const links = document.querySelectorAll(".mobile-nav-link");
  const header = document.querySelector("header");

  function openMenu() {
    if (!menu || !toggleBtn) return;
    if (header) {
      menu.style.top = `${header.offsetHeight}px`;
    }
    menu.classList.add("is-open");
    menu.setAttribute("aria-hidden", "false");
    toggleBtn.setAttribute("aria-expanded", "true");
    toggleBtn.setAttribute("aria-label", "Close menu");
    document.body.classList.add("overflow-hidden");
  }

  function closeMenu() {
    if (!menu || !toggleBtn) return;
    menu.classList.remove("is-open");
    menu.setAttribute("aria-hidden", "true");
    toggleBtn.setAttribute("aria-expanded", "false");
    toggleBtn.setAttribute("aria-label", "Open menu");
    document.body.classList.remove("overflow-hidden");
  }

  toggleBtn?.addEventListener("click", () => {
    const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
    if (isExpanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  links.forEach((l) => {
    l.addEventListener("click", () => {
      closeMenu();
    });
  });

  // Close menu on backdrop click
  menu?.addEventListener("click", (e) => {
    if (e.target === menu) {
      closeMenu();
    }
  });

  // Close menu on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggleBtn?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggleBtn.focus();
    }
  });

  // Reset when viewport resizes to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && toggleBtn?.getAttribute("aria-expanded") === "true") {
      closeMenu();
    }
  });
</script>

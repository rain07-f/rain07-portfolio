---
import BrutalistButton from './BrutalistButton.astro';

interface ActionItem {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'accent';
}

interface Props {
  statusCode?: string;
  statusType?: string;
  systemName?: string;
  title: string;
  subtitle?: string;
  description: string;
  technicalMessage?: string;
  primaryAction?: ActionItem;
  secondaryAction?: ActionItem;
  tertiaryAction?: ActionItem;
  class?: string;
}

const {
  statusCode = '404',
  statusType = 'NOT FOUND',
  systemName = 'RAIN07 // SYS',
  title,
  subtitle,
  description,
  technicalMessage,
  primaryAction = { label: '← BACK TO HOME', href: '/', variant: 'primary' },
  secondaryAction = { label: 'VIEW WORK →', href: '/work', variant: 'secondary' },
  tertiaryAction,
  class: className = ''
} = Astro.props;
---

<div class={`w-full max-w-5xl mx-auto ${className}`}>
  <!-- Outer Brutalist System Container -->
  <div class="border-2 border-[#111111] bg-[#FFFFFF] shadow-hard">
    <!-- Top System Telemetry Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-[#111111] bg-[#F2F0EA] px-4 md:px-6 py-2.5 font-mono text-xs">
      <div class="flex items-center gap-2.5">
        <span class={`font-bold px-2 py-0.5 text-[11px] ${
          statusCode === '404' || statusCode === '500' || statusCode === '503'
            ? 'bg-[#FF3B30] text-[#FFFFFF]'
            : 'bg-[#111111] text-[#F2F0EA]'
        }`}>
          HTTP STATUS // {statusCode}
        </span>
        <span class="font-bold text-[#111111] uppercase tracking-wider">
          {statusType}
        </span>
      </div>
      <div class="flex items-center gap-2 text-[#111111]/70 text-[11px]">
        <span>SYSTEM:</span>
        <span class="font-bold text-[#111111]">{systemName}</span>
      </div>
    </div>

    <!-- Main Content Grid: Asymmetric Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-[#111111]">
      <!-- Left Column: Big Status Number / Monolithic Indicator -->
      <div class="lg:col-span-4 p-8 md:p-12 bg-[#F2F0EA]/40 flex flex-col justify-between items-start">
        <div class="space-y-2 w-full">
          <div class="font-mono text-xs font-bold text-[#0057FF] uppercase tracking-widest">
            STATE IDENTIFIER
          </div>
          <div class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-black tracking-tighter leading-none text-[#111111] font-mono select-none">
            {statusCode}
          </div>
        </div>

        {technicalMessage && (
          <div class="mt-8 pt-4 border-t-2 border-[#111111]/20 font-mono text-[11px] text-[#111111]/75 w-full leading-relaxed">
            <span class="text-[#0057FF] font-bold block mb-1">// SYSTEM LOG:</span>
            {technicalMessage}
          </div>
        )}
      </div>

      <!-- Right Column: Heading, Description, Metadata Matrix & Actions -->
      <div class="lg:col-span-8 p-6 sm:p-8 md:p-12 flex flex-col justify-between space-y-8">
        <div class="space-y-4">
          {subtitle && (
            <div class="font-mono text-xs sm:text-sm font-bold tracking-widest text-[#0057FF] uppercase">
              {subtitle}
            </div>
          )}
          <h1 class="text-2xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-[#111111] leading-[1.05]">
            {title}
          </h1>
          <p class="font-mono text-sm sm:text-base text-[#111111]/85 leading-relaxed max-w-2xl">
            {description}
          </p>
        </div>

        <!-- Technical Telemetry Matrix -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-6 border-t-2 border-[#111111]/20 font-mono text-xs">
          <div>
            <div class="text-[#111111]/60 uppercase text-[10px]">STATUS</div>
            <div class="font-bold text-[#111111]">{statusCode}</div>
          </div>
          <div>
            <div class="text-[#111111]/60 uppercase text-[10px]">CONDITION</div>
            <div class="font-bold text-[#0057FF]">{statusType}</div>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <div class="text-[#111111]/60 uppercase text-[10px]">RUNTIME</div>
            <div class="font-bold text-[#111111]">CLOUDFLARE EDGE</div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="pt-6 border-t-2 border-[#111111]/20 flex flex-wrap items-center gap-3">
          {primaryAction && (
            <BrutalistButton
              href={primaryAction.href}
              variant={primaryAction.variant || 'primary'}
            >
              {primaryAction.label}
            </BrutalistButton>
          )}
          {secondaryAction && (
            <BrutalistButton
              href={secondaryAction.href}
              variant={secondaryAction.variant || 'secondary'}
            >
              {secondaryAction.label}
            </BrutalistButton>
          )}
          {tertiaryAction && (
            <BrutalistButton
              href={tertiaryAction.href}
              variant={tertiaryAction.variant || 'secondary'}
            >
              {tertiaryAction.label}
            </BrutalistButton>
          )}
        </div>
      </div>
    </div>
  </div>
</div>

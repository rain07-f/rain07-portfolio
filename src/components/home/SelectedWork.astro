---
import SectionLabel from '../SectionLabel.astro';
import ProjectCard from '../ProjectCard.astro';
import BrutalistButton from '../BrutalistButton.astro';
import { getPortfolioItems } from '../../lib/api/client';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLang } from '../../i18n/config';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = 'id' } = Astro.props;
const t = useTranslations(currentLang);
const prefix = currentLang === 'en' ? '/en' : '';

const allProjects = await getPortfolioItems();
// Enforce strict limit: Maximum 3 project cards on the homepage
const projects = allProjects.slice(0, 3);
---

<section id="work" class="border-b-2 border-[#111111] bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="work-header">
      <SectionLabel index={t('work.index')} title={t('work.sectionTitle')} />

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div class="max-w-3xl">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-[#111111]">
            {t('work.headline')}
          </h2>
          <p class="font-mono text-xs sm:text-sm text-[#111111]/75 mt-2">
            {t('work.description')}
          </p>
        </div>

        <BrutalistButton href={`${prefix}/work/`} variant="secondary" class="self-start md:self-auto !text-xs sm:!text-sm">
          {t('work.viewAll')} ({allProjects.length}) →
        </BrutalistButton>
      </div>
    </div>

    <!-- Project Cards Grid (Max 3) -->
    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project, idx) => (
          <div class={`project-card reveal-item flex flex-col ${idx === 0 ? 'md:col-span-2 lg:col-span-1' : ''}`} style={`--stagger: ${idx};`}>
            <ProjectCard project={project} featured={false} currentLang={currentLang} />
          </div>
        ))}
      </div>
    ) : (
      <div class="reveal-item border-2 border-[#111111] bg-[#FFFFFF] p-8 md:p-12 shadow-hard font-mono text-sm space-y-3">
        <div class="flex items-center gap-2">
          <span class="bg-[#111111] text-[#F2F0EA] px-2 py-0.5 text-xs font-bold">STATUS: EMPTY</span>
          <span class="text-[#0057FF] font-bold text-xs uppercase">// WORK ARCHIVE</span>
        </div>
        <div class="text-base font-bold text-[#111111] uppercase tracking-tight">
          {t('work.empty')}
        </div>
      </div>
    )}
  </div>
</section>


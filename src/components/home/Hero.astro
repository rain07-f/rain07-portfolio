---
import BrutalistButton from '../BrutalistButton.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLang } from '../../i18n/config';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = 'id' } = Astro.props;
const t = useTranslations(currentLang);
const prefix = currentLang === 'en' ? '/en' : '';
---

<section
  id="home"
  class="border-b-2 border-[#111111] bg-[#F2F0EA] relative overflow-hidden"
>
  <!-- Subtle Blueprint grid lines background -->
  <div class="absolute inset-0 grid-blueprint opacity-60 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 py-14 sm:py-20 md:py-24 relative z-10">
    <!-- Top Metadata Bar -->
    <div
      class="flex flex-wrap items-center justify-between gap-3 border-2 border-[#111111] bg-[#FFFFFF] p-3 shadow-hard mb-8 font-mono text-xs"
    >
      <div class="flex items-center gap-2.5">
        <span class="bg-[#111111] text-[#F2F0EA] px-2 py-0.5 font-bold">RAIN07</span>
        <span class="font-bold text-[#111111]">{t('hero.location')}</span>
      </div>
      <div class="flex items-center gap-2 text-[#111111]/80 text-[11px] sm:text-xs">
        <span class="font-bold text-[#0057FF]">PILLARS /</span>
        <span>WEB DEVELOPMENT · IT INFRASTRUCTURE</span>
      </div>
    </div>

    <!-- Main Hero Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      <!-- Left: Massive Typography Statement -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6 sm:space-y-8">
        <div class="space-y-4">
          <div
            class="font-mono text-xs md:text-sm font-bold tracking-widest text-[#0057FF] uppercase"
          >
            {t('hero.badge')}
          </div>
          <h1
            class="text-3xl sm:text-5xl md:text-6xl lg:text-[4.75rem] font-black tracking-tight leading-[0.94] uppercase text-[#111111]"
          >
            {t('hero.headline')}
          </h1>
        </div>

        <p
          class="font-mono text-sm sm:text-base md:text-lg text-[#111111]/90 max-w-2xl leading-relaxed border-l-4 border-[#0057FF] pl-4"
        >
          {t('hero.description')}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 pt-2">
          <BrutalistButton
            href={`${prefix}/work/`}
            variant="primary"
            class="!text-xs sm:!text-sm md:!text-base !px-6 !py-4"
          >
            {t('hero.cta.work')}
          </BrutalistButton>
          <BrutalistButton
            href={`${prefix}/#contact`}
            variant="secondary"
            class="!text-xs sm:!text-sm md:!text-base !px-6 !py-4"
          >
            {t('hero.cta.contact')}
          </BrutalistButton>
        </div>
      </div>

      <!-- Right: Framed Developer Workstation Image Panel -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div
          class="border-2 border-[#111111] bg-[#111111] shadow-hard flex flex-col h-full overflow-hidden group"
        >
          <div
            class="relative flex-1 min-h-[280px] sm:min-h-[360px] lg:min-h-[440px] bg-[#111111] overflow-hidden"
          >
            <picture class="w-full h-full block">
              <source
                type="image/avif"
                srcset="/images/hero-developer-480w.avif 480w, /images/hero-developer-800w.avif 800w, /images/hero-developer-1200w.avif 1200w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 533px"
              />
              <source
                type="image/webp"
                srcset="/images/hero-developer-480w.webp 480w, /images/hero-developer-800w.webp 800w, /images/hero-developer-1200w.webp 1200w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 533px"
              />
              <img
                src="/images/hero-developer-800w.jpg"
                srcset="/images/hero-developer-480w.jpg 480w, /images/hero-developer-800w.jpg 800w, /images/hero-developer-1200w.jpg 1200w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 533px"
                alt="RAIN07 Engineering Workstation — Web Development and IT Infrastructure"
                width="800"
                height="597"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 transition-all duration-300"
              />
            </picture>
            <div
              class="absolute bottom-3 left-3 bg-[#111111]/90 text-[#F2F0EA] border border-[#111111] px-2.5 py-1 font-mono text-[10px] tracking-wider uppercase"
            >
              SYS // WORKSTATION · DUAL ROLE
            </div>
          </div>

          <!-- Bottom Telemetry strip -->
          <div
            class="border-t-2 border-[#111111] bg-[#FFFFFF] px-4 py-2.5 flex items-center justify-between font-mono text-[11px] text-[#111111]/80"
          >
            <span>{t('hero.runtime')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


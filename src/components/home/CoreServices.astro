---
import SectionLabel from '../SectionLabel.astro';
import BrutalistButton from '../BrutalistButton.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLang } from '../../i18n/config';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = 'id' } = Astro.props;
const t = useTranslations(currentLang);
const prefix = currentLang === 'en' ? '/en' : '';

const webItems: string[] = t('services.web.items');
const infraItems: string[] = t('services.infra.items');
---

<section id="services" class="border-b-2 border-[#111111] bg-[#F2F0EA] py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <SectionLabel index={t('services.index')} title={t('services.sectionTitle')} />

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-[#111111]">
          {currentLang === 'id' ? 'DUA PILAR UTAMA LAYANAN' : 'TWO CORE SPECIALIZATIONS'}
        </h2>
        <p class="font-mono text-xs sm:text-sm text-[#111111]/75 mt-2">
          {t('services.subtitle')}
        </p>
      </div>

      <BrutalistButton href={`${prefix}/services/`} variant="secondary" class="self-start md:self-auto !text-xs sm:!text-sm">
        {t('services.viewAll')}
      </BrutalistButton>
    </div>

    <!-- Dual Cards Grid: Equal Importance -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <!-- Card 01: Web Development -->
      <article class="reveal-item border-2 border-[#111111] bg-[#FFFFFF] p-6 sm:p-8 md:p-10 shadow-hard flex flex-col justify-between group">
        <div>
          <!-- Header strip -->
          <div class="flex items-center justify-between border-b-2 border-[#111111] pb-4 mb-6">
            <span class="font-mono text-xs font-bold px-2.5 py-1 bg-[#111111] text-[#F2F0EA] group-hover:bg-[#0057FF] group-hover:text-[#FFFFFF] transition-colors">
              {t('services.web.badge')}
            </span>
            <span class="font-mono text-xs text-[#0057FF] font-bold">SOFTWARE & CMS</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#111111] leading-tight mb-4">
            {t('services.web.headline')}
          </h3>

          <p class="font-mono text-xs sm:text-sm md:text-base text-[#111111]/85 leading-relaxed mb-8">
            {t('services.web.description')}
          </p>
        </div>

        <div>
          <div class="border-t-2 border-[#111111]/15 pt-5 mb-4">
            <div class="font-mono text-xs font-bold text-[#0057FF] uppercase tracking-wider mb-3">
              // KEY FOCUS AREAS
            </div>
            <ul class="space-y-2 font-mono text-xs sm:text-sm text-[#111111]/90">
              {webItems.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#0057FF] font-bold">›</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <!-- Card 02: IT Infrastructure -->
      <article class="reveal-item border-2 border-[#111111] bg-[#FFFFFF] p-6 sm:p-8 md:p-10 shadow-hard flex flex-col justify-between group" style="--stagger: 1;">
        <div>
          <!-- Header strip -->
          <div class="flex items-center justify-between border-b-2 border-[#111111] pb-4 mb-6">
            <span class="font-mono text-xs font-bold px-2.5 py-1 bg-[#111111] text-[#F2F0EA] group-hover:bg-[#0057FF] group-hover:text-[#FFFFFF] transition-colors">
              {t('services.infra.badge')}
            </span>
            <span class="font-mono text-xs text-[#0057FF] font-bold">SYSTEMS & NETWORK</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#111111] leading-tight mb-4">
            {t('services.infra.headline')}
          </h3>

          <p class="font-mono text-xs sm:text-sm md:text-base text-[#111111]/85 leading-relaxed mb-8">
            {t('services.infra.description')}
          </p>
        </div>

        <div>
          <div class="border-t-2 border-[#111111]/15 pt-5 mb-4">
            <div class="font-mono text-xs font-bold text-[#0057FF] uppercase tracking-wider mb-3">
              // KEY FOCUS AREAS
            </div>
            <ul class="space-y-2 font-mono text-xs sm:text-sm text-[#111111]/90">
              {infraItems.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#0057FF] font-bold">›</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>


---
import { getAlternateLinks } from '../i18n/utils';
import type { SupportedLang } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number | string;
  imageHeight?: number | string;
  imageType?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  locale?: SupportedLang;
}

const rawSiteUrl = (typeof process !== 'undefined' && process.env?.PUBLIC_SITE_URL) || import.meta.env?.PUBLIC_SITE_URL || 'https://rain07.my.id';
const siteUrl = rawSiteUrl.replace(/\/$/, '');

// Default RAIN07 Hero Open Graph Image (1200x630 px social derivative)
const DEFAULT_HERO_OG_IMAGE = `${siteUrl}/images/hero-developer-og.jpg`;
const DEFAULT_HERO_OG_ALT = 'RAIN07 Engineering Workstation — Web Development & IT Infrastructure';

const {
  title,
  description,
  canonical,
  image = DEFAULT_HERO_OG_IMAGE,
  imageAlt = DEFAULT_HERO_OG_ALT,
  imageWidth,
  imageHeight,
  imageType,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author = 'Reyno Nur Fahreza',
  section,
  jsonLd,
  locale = 'id'
} = Astro.props;

// Format canonical URL ensuring clean domain + trailing slash consistency matching Astro static builds
const formatCanonical = (urlPath: string): string => {
  if (canonical) {
    return canonical.startsWith('http') ? canonical : `${siteUrl}${canonical.startsWith('/') ? '' : '/'}${canonical}`;
  }
  const cleanPath = urlPath.replace(/\/index\.html$/, '').replace(/\.html$/, '');
  const withTrailing = cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
  return `${siteUrl}${withTrailing.startsWith('/') ? '' : '/'}${withTrailing}`;
};

const canonicalUrl = formatCanonical(Astro.url.pathname);
const alternateLinks = getAlternateLinks(Astro.url.pathname, siteUrl);

// Resolve social preview image (must be absolute URL and NEVER an unrelated WordPress media asset)
let resolvedImage = image;
if (!resolvedImage || resolvedImage.includes('pembuatan-website-featured-1788341128')) {
  resolvedImage = DEFAULT_HERO_OG_IMAGE;
} else if (!resolvedImage.startsWith('http')) {
  resolvedImage = `${siteUrl}${resolvedImage.startsWith('/') ? '' : '/'}${resolvedImage}`;
}

// Secure HTTPS URL for og:image:secure_url
const secureImageUrl = resolvedImage.startsWith('http:')
  ? resolvedImage.replace(/^http:/, 'https:')
  : resolvedImage;

// Resolve dimensions
const isDefaultHero = resolvedImage.includes('hero-developer-og.jpg');
const resolvedWidth = imageWidth || (isDefaultHero ? 1200 : 1200);
const resolvedHeight = imageHeight || (isDefaultHero ? 630 : 630);

// Resolve MIME type
let resolvedImageType = imageType;
if (!resolvedImageType) {
  if (resolvedImage.endsWith('.png')) {
    resolvedImageType = 'image/png';
  } else if (resolvedImage.endsWith('.webp')) {
    resolvedImageType = 'image/webp';
  } else if (resolvedImage.endsWith('.avif')) {
    resolvedImageType = 'image/avif';
  } else {
    resolvedImageType = 'image/jpeg';
  }
}

// Google Search Console verification token (if supplied via env)
const googleSiteVerification =
  (typeof process !== 'undefined' && (process.env?.PUBLIC_GOOGLE_SITE_VERIFICATION || process.env?.GOOGLE_SITE_VERIFICATION)) ||
  import.meta.env?.PUBLIC_GOOGLE_SITE_VERIFICATION ||
  '';

const ogLocale = locale === 'id' ? 'id_ID' : 'en_US';
---

<!-- Core Meta -->
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}
{!noindex && <link rel="canonical" href={canonicalUrl} />}

<!-- Reciprocal Hreflang Tags for Bilingual International SEO -->
{!noindex && (
  <>
    <link rel="alternate" hreflang="id" href={alternateLinks.id} />
    <link rel="alternate" hreflang="en" href={alternateLinks.en} />
    <link rel="alternate" hreflang="x-default" href={alternateLinks.xDefault} />
  </>
)}

<!-- Optional Google Search Console Verification Meta -->
{googleSiteVerification && (
  <meta name="google-site-verification" content={googleSiteVerification} />
)}

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:site_name" content="RAIN07" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={ogLocale} />
{resolvedImage && (
  <>
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:secure_url" content={secureImageUrl} />
    <meta property="og:image:type" content={resolvedImageType} />
    <meta property="og:image:width" content={String(resolvedWidth)} />
    <meta property="og:image:height" content={String(resolvedHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
  </>
)}
{resolvedImage && imageAlt && (
  <meta property="og:image:alt" content={imageAlt} />
)}
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}
{type === 'article' && section && (
  <meta property="article:section" content={section} />
)}

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{resolvedImage && (
  <meta name="twitter:image" content={resolvedImage} />
)}
{resolvedImage && imageAlt && (
  <meta name="twitter:image:alt" content={imageAlt} />
)}

<!-- Structured Data (JSON-LD) -->
{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

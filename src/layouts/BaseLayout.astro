---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'RAIN07 — Web Developer & Infrastructure Engineer',
  description = 'Reyno Nur Fahreza (RAIN07) is a Web Developer & Infrastructure Engineer working across WordPress, Laravel, Linux infrastructure, cloud deployment, and technical systems.',
  ogImage = 'https://be-web-por-rey.rey07.my.id/wp-content/uploads/2026/09/pembuatan-website-featured-1788341128.png',
  imageAlt = 'RAIN07 — Web Developer & Infrastructure Engineer',
  ogType = 'website',
  canonical,
  noindex = false,
  publishedTime,
  modifiedTime,
  author = 'Reyno Nur Fahreza',
  section,
  jsonLd
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preload critical typography for instant rendering without FOUT/CLS -->
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preload LCP hero image for mobile and desktop -->
    <link
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset="/images/hero-developer-480w.avif 480w, /images/hero-developer-800w.avif 800w, /images/hero-developer-1200w.avif 1200w"
      imagesizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 533px"
      fetchpriority="high"
    />

    <!-- Favicon & Touch Icons from WordPress Site Icon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Analytics (Deferred to avoid main-thread and bandwidth contention) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-85BHR4FKNN');

      function initAnalytics() {
        if (window.__gtagLoaded) return;
        window.__gtagLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-85BHR4FKNN';
        document.head.appendChild(s);
      }

      ['scroll', 'touchstart', 'mousemove', 'click', 'keydown'].forEach(function(e) {
        window.addEventListener(e, initAnalytics, { passive: true, once: true });
      });
      setTimeout(initAnalytics, 6000);
    </script>

    <!-- Centralized SEO Component -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={ogImage}
      imageAlt={imageAlt}
      type={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      section={section}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#F2F0EA] text-[#111111]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <FloatingActions />

    <!-- Unified Motion System: Progressive Scroll Reveal -->
    <script>
      function setupMotionSystem() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return;
        }

        const revealItems = document.querySelectorAll('.reveal-item:not(.is-revealed)');
        if (!revealItems.length) return;

        // Activate progressive reveal styling only when JS & IntersectionObserver are operational
        document.documentElement.classList.add('js-reveal');

        if (!('IntersectionObserver' in window)) {
          revealItems.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            root: null,
            rootMargin: '0px 0px -40px 0px',
            threshold: 0.08,
          }
        );

        revealItems.forEach((el) => {
          const rect = el.getBoundingClientRect();
          // Elements already in initial viewport reveal immediately to prevent any LCP delay
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('is-revealed');
          } else {
            observer.observe(el);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupMotionSystem);
      } else {
        setupMotionSystem();
      }
      document.addEventListener('astro:page-load', setupMotionSystem);
    </script>
  </body>
</html>


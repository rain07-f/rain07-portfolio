---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
}

const {
  title = 'RAIN07 // Web Developer & Infrastructure Engineer',
  description = 'Web Developer & Infrastructure Engineer. Building applications, decoupled systems, Linux infrastructure and Cloudflare edge deployments.',
  ogImage = 'https://be-web-por-rey.rey07.my.id/wp-content/uploads/2026/09/pembuatan-website-featured-1788341128.png',
  ogType = 'website',
  canonical
} = Astro.props;

const siteUrl = 'https://rain07.my.id';
const currentUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'RAIN07',
      description: 'Web Developer & Infrastructure Engineer Portfolio',
      inLanguage: 'en-US'
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'RAIN07',
      alternateName: 'REYNO07',
      jobTitle: 'Web Developer & Infrastructure Engineer',
      url: siteUrl,
      sameAs: [
        'https://linkedin.com/in/reyno-nur-fahreza'
      ],
      knowsAbout: [
        'Web Development',
        'WordPress',
        'Laravel',
        'Linux Administration',
        'Cloudflare Workers',
        'Networking',
        'IT Infrastructure'
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Space Grotesk, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700;800&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content="RAIN07" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#F2F0EA] text-[#111111]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

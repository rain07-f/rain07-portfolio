---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'RAIN07 — Web Developer & Infrastructure Engineer',
  description = 'Reyno Fahreza (RAIN07) is a Web Developer & Infrastructure Engineer working across WordPress, Laravel, Linux infrastructure, cloud deployment, and technical systems.',
  ogImage = 'https://be-web-por-rey.rey07.my.id/wp-content/uploads/2026/09/pembuatan-website-featured-1788341128.png',
  imageAlt = 'RAIN07 — Web Developer & Infrastructure Engineer',
  ogType = 'website',
  canonical,
  noindex = false,
  publishedTime,
  modifiedTime,
  author = 'Reyno Fahreza',
  section,
  jsonLd
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Space Grotesk, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700;800&family=Space+Grotesk:wght@500;700;900&display=swap" rel="stylesheet">

    <!-- Centralized SEO Component -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={ogImage}
      imageAlt={imageAlt}
      type={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      section={section}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#F2F0EA] text-[#111111]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <FloatingActions />
  </body>
</html>


---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import BrutalistButton from '../../../components/BrutalistButton.astro';
import { EXPERIENCE_ROLES } from '../../../lib/content/profile';

const siteUrl = 'https://rain07.my.id';

const breadcrumbsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': `${siteUrl}/en/`
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'About',
      'item': `${siteUrl}/en/about/`
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': 'Experience',
      'item': `${siteUrl}/en/about/experience/`
    }
  ]
};
---

<BaseLayout
  title="Career History & Professional Experience — Reyno Nur Fahreza | RAIN07"
  description="Verified professional background and roles of Reyno Nur Fahreza spanning web development, Linux systems administration, IT project engineering, and infrastructure planning."
  canonical="/en/about/experience/"
  locale="en"
  jsonLd={breadcrumbsJsonLd}
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <SectionLabel index="04 // EXPERIENCE" title="CAREER TIMELINE" />

    <!-- Intro Header -->
    <div class="border-2 border-[#111111] bg-[#FFFFFF] p-8 md:p-12 shadow-hard mb-12">
      <div class="max-w-3xl space-y-4">
        <span class="font-mono text-xs font-bold px-2 py-1 bg-[#0057FF] text-[#FFFFFF]">
          VERIFIED CAREER TIMELINE // 2015 – PRESENT
        </span>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight text-[#111111]">
          PROFESSIONAL EXPERIENCE
        </h1>
        <p class="font-mono text-sm md:text-base text-[#111111]/80 leading-relaxed">
          Comprehensive career record detailing technical responsibilities, engineering projects, web operations, and infrastructure deployments across 9+ years of industry practice.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t-2 border-[#111111]/20 flex flex-wrap items-center gap-4">
        <BrutalistButton href="/en/about/" variant="secondary" class="!text-xs">
          ← BACK TO ABOUT
        </BrutalistButton>
        <BrutalistButton href="/en/work/" variant="primary" class="!text-xs">
          EXPLORE WORK →
        </BrutalistButton>
      </div>
    </div>

    <!-- Roles Timeline Grid -->
    <div class="space-y-6">
      {EXPERIENCE_ROLES.map((role, idx) => (
        <article class="reveal-item border-2 border-[#111111] bg-[#FFFFFF] p-6 md:p-8 shadow-hard" style={`--stagger: ${idx};`}>
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b-2 border-[#111111] pb-4 mb-6">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold px-2.5 py-1 bg-[#111111] text-[#F2F0EA]">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <h2 class="text-xl md:text-2xl font-black uppercase tracking-tight text-[#111111]">
                {role.title}
              </h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-bold px-2.5 py-1 bg-[#0057FF] text-[#FFFFFF]">
                {role.period}
              </span>
            </div>
          </div>

          <div class="font-mono text-xs text-[#0057FF] font-bold mb-3 uppercase tracking-wider">
            {role.org}
          </div>

          <p class="font-mono text-sm text-[#111111]/90 mb-6 leading-relaxed">
            {role.summary}
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-[#111111]/20">
            <!-- Left: Scope -->
            <div>
              <div class="font-mono text-xs font-bold uppercase text-[#0057FF] mb-3">
                // SCOPE & RESPONSIBILITIES
              </div>
              <ul class="space-y-1.5 font-mono text-xs text-[#111111]/85">
                {role.scope.map((s) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#0057FF] font-bold">›</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Right: Tech Stack -->
            <div>
              <div class="font-mono text-xs font-bold uppercase text-[#111111] mb-3">
                // TECHNOLOGIES & TOOLS
              </div>
              <div class="flex flex-wrap gap-2">
                {role.technologies.map((t) => (
                  <span class="font-mono text-xs px-2 py-1 border border-[#111111] bg-[#F2F0EA] text-[#111111] font-semibold">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>


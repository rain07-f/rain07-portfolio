---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import SystemState from '../../../components/SystemState.astro';
import { getPortfolioItems, getPortfolioCategories } from '../../../lib/api/client';

const projects = await getPortfolioItems();
const categories = await getPortfolioCategories();
const siteUrl = 'https://rain07.my.id';

const workJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': `${siteUrl}/en/`
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Work',
          'item': `${siteUrl}/en/work/`
        }
      ]
    },
    {
      '@type': 'CollectionPage',
      '@id': `${siteUrl}/en/work/#webpage`,
      'url': `${siteUrl}/en/work/`,
      'name': 'Selected Work & Projects — RAIN07',
      'description': 'Selected engineering, web applications, and infrastructure projects delivered by Reyno Nur Fahreza.'
    }
  ]
};
---

<BaseLayout
  title="Selected Work & Case Studies — RAIN07"
  description="Explore production websites, web applications, WordPress builds, and server deployments delivered by Reyno."
  canonical="/en/work/"
  ogType="website"
  locale="en"
  jsonLd={workJsonLd}
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <SectionLabel index="02 // WORK" title="SELECTED PROJECTS" />

    <!-- Intro Header -->
    <div class="border-2 border-[#111111] bg-[#FFFFFF] p-8 md:p-12 shadow-hard mb-12">
      <div class="max-w-3xl space-y-4">
        <span class="font-mono text-xs font-bold px-2 py-1 bg-[#0057FF] text-[#FFFFFF]">
          LIVE DATA STREAM // WORDPRESS CPT
        </span>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight text-[#111111]">
          SELECTED PROJECTS
        </h1>
        <p class="font-mono text-sm md:text-base text-[#111111]/80 leading-relaxed">
          Production business websites, custom web applications, and IT infrastructure implementations loaded dynamically from the headless WordPress instance.
        </p>
      </div>

      <!-- Categories Filter bar -->
      {categories.length > 0 && (
        <div class="mt-8 pt-6 border-t-2 border-[#111111]/20 flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="font-bold text-[#111111] mr-2">TAXONOMY:</span>
          <span class="px-2 py-1 bg-[#111111] text-[#F2F0EA] font-semibold">ALL ({projects.length})</span>
          {categories.map((cat) => (
            <span class="px-2 py-1 border border-[#111111] bg-[#F2F0EA] text-[#111111] font-semibold">
              {cat.name}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Projects Grid -->
    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project, idx) => (
          <div class={`reveal-item flex flex-col ${idx === 0 ? 'md:col-span-2' : ''}`} style={`--stagger: ${idx % 3};`}>
            <ProjectCard project={project} featured={idx === 0} currentLang="en" />
          </div>
        ))}
      </div>
    ) : (
      <SystemState
        class="reveal-item"
        statusCode="EMPTY"
        statusType="WORK ARCHIVE"
        systemName="RAIN07 // ARCHIVE"
        subtitle="NO PROJECTS FOUND"
        title="WORK ARCHIVE CURRENTLY EMPTY."
        description="The work archive currently contains no published project case studies. New architectures and client builds will appear here once published."
        technicalMessage="REST query /wp-json/wp/v2/portfolio returned 0 records."
        primaryAction={{
          label: "← BACK TO HOME",
          href: "/en/",
          variant: "primary"
        }}
        secondaryAction={{
          label: "TECHNICAL NOTES →",
          href: "/en/notes",
          variant: "secondary"
        }}
      />
    )}
  </div>
</BaseLayout>


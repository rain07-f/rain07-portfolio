---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import BrutalistButton from '../../components/BrutalistButton.astro';

const siteUrl = 'https://rain07.my.id';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/about/#person`,
  name: 'Reyno Nur Fahreza',
  alternateName: ['RAIN07', 'REYNO07'],
  jobTitle: 'Web Development & IT Infrastructure Engineer',
  url: `${siteUrl}/about/`,
  sameAs: [
    'https://www.linkedin.com/in/reyno-nur-fahreza-85908999/'
  ],
  knowsAbout: [
    'Web Development',
    'WordPress',
    'Elementor',
    'Laravel',
    'PHP',
    'Astro',
    'Linux Administration',
    'Docker',
    'Proxmox',
    'MikroTik',
    'Cloudflare',
    'IT Infrastructure'
  ]
};
---

<BaseLayout
  title="Tentang Reyno Nur Fahreza | RAIN07"
  description="Kenali Reyno Nur Fahreza, profesional teknologi dengan pengalaman di bidang web development, IT infrastructure, dan project engineering."
  canonical="/about/"
  locale="id"
  jsonLd={personJsonLd}
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <SectionLabel index="04 // TENTANG" title="PROFIL PROFESIONAL" />

    <!-- Editorial Hero -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-12">
      <!-- Left Asymmetric Editorial Column -->
      <div class="lg:col-span-7 border-2 border-[#111111] bg-[#FFFFFF] p-8 md:p-12 shadow-hard flex flex-col justify-between">
        <div>
          <span class="font-mono text-xs font-bold text-[#0057FF] uppercase tracking-widest block mb-3">
            // PENDEKATAN PRAKTIS DALAM TEKNOLOGI
          </span>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight leading-[1.05] text-[#111111]">
            MEMBANGUN SOLUSI DIGITAL. MENGELOLA INFRASTRUKTUR TEKNOLOGI.
          </h1>
        </div>

        <p class="font-mono text-sm md:text-base text-[#111111]/85 leading-relaxed my-6 md:my-8">
          Saya Reyno Nur Fahreza, profesional teknologi independen dengan pengalaman di bidang pengembangan web, infrastruktur IT, dan engineering proyek teknis. Pekerjaan saya menggabungkan pengembangan perangkat lunak dan pengelolaan infrastruktur—mulai dari membangun website dan aplikasi web hingga mengimplementasikan serta mengelola server, jaringan, dan sistem IT.
        </p>

        <div class="border-t-2 border-[#111111]/20 pt-6 font-mono text-xs sm:text-sm text-[#111111]/70 leading-relaxed space-y-4">
          <p>
            Saya percaya teknologi seharusnya menyelesaikan masalah nyata, bekerja secara andal, dan mudah dikelola dalam jangka panjang tanpa kerumitan yang tidak perlu.
          </p>
          <div class="pt-2">
            <BrutalistButton href="/about/experience/" variant="primary" class="!text-xs">
              LIHAT RIWAYAT PENGALAMAN LENGKAP (2015 – SEKARANG) →
            </BrutalistButton>
          </div>
        </div>
      </div>

      <!-- Right Column: System Tenets -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="border-2 border-[#111111] bg-[#111111] text-[#F2F0EA] p-6 md:p-8 shadow-hard flex-1 flex flex-col justify-center">
          <div class="font-mono text-xs font-bold text-[#D9FF00] uppercase tracking-wider mb-2.5">
            01 // PENDEKATAN PRAKTIS
          </div>
          <p class="font-mono text-xs sm:text-sm leading-relaxed text-[#F2F0EA]/90">
            Memahami kebutuhan fungsional dan teknis sebelum memilih alat. Menghindari over-engineering dan fokus pada solusi yang terbukti handal.
          </p>
        </div>

        <div class="border-2 border-[#111111] bg-[#FFFFFF] text-[#111111] p-6 md:p-8 shadow-hard flex-1 flex flex-col justify-center">
          <div class="font-mono text-xs font-bold text-[#0057FF] uppercase tracking-wider mb-2.5">
            02 // FLEKSIBILITAS TEKNIS
          </div>
          <p class="font-mono text-xs sm:text-sm leading-relaxed text-[#111111]/90">
            Menguasai lapisan aplikasi web sekaligus lapisan server dan jaringan, sehingga troubleshooting dapat dilakukan langsung pada akar permasalahan.
          </p>
        </div>

        <div class="border-2 border-[#111111] bg-[#0057FF] text-[#FFFFFF] p-6 md:p-8 shadow-hard flex-1 flex flex-col justify-center">
          <div class="font-mono text-xs font-bold text-[#FFFFFF] uppercase tracking-wider mb-2.5">
            03 // KETEPATAN EKSEKUSI
          </div>
          <p class="font-mono text-xs sm:text-sm leading-relaxed text-[#FFFFFF]/90">
            Mulai dari spesifikasi perangkat keras, estimasi RAB/BOQ, hingga konfigurasi reverse proxy dan deployment sistem yang terstruktur.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>


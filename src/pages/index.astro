---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import CoreServices from '../components/home/CoreServices.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import ExpertiseTech from '../components/home/ExpertiseTech.astro';
import AboutEditorial from '../components/home/AboutEditorial.astro';
import ContactCta from '../components/home/ContactCta.astro';

const siteUrl = 'https://rain07.my.id';

const homepageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'RAIN07',
      description: 'Web Development & IT Infrastructure',
      inLanguage: 'id'
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Reyno Nur Fahreza',
      alternateName: ['RAIN07', 'REYNO07'],
      jobTitle: 'Web Development & IT Infrastructure Engineer',
      url: `${siteUrl}/`,
      sameAs: [
        'https://www.linkedin.com/in/reyno-nur-fahreza-85908999/'
      ],
      knowsAbout: [
        'Web Development',
        'WordPress',
        'Elementor',
        'Laravel',
        'PHP',
        'Astro',
        'Linux Administration',
        'Docker',
        'Proxmox',
        'MikroTik',
        'Cloudflare',
        'IT Infrastructure'
      ]
    }
  ]
};
---

<BaseLayout
  title="RAIN07 | Web Development & IT Infrastructure Indonesia"
  description="Solusi pengembangan website, aplikasi web, dan infrastruktur IT untuk kebutuhan bisnis. Kenali layanan, project, dan keahlian Reyno."
  canonical="/"
  ogType="website"
  ogImage="/images/hero-developer-og.jpg"
  imageAlt="RAIN07 Engineering Workstation — Web Development & IT Infrastructure"
  imageWidth={1200}
  imageHeight={630}
  imageType="image/jpeg"
  jsonLd={homepageJsonLd}
  locale="id"
>
  <!-- 01 HERO / INTRODUCTION -->
  <Hero currentLang="id" />

  <!-- 02 CORE SERVICES (Web Development & IT Infrastructure) -->
  <CoreServices currentLang="id" />

  <!-- 03 SELECTED PROJECTS (Max 3 verified project cards) -->
  <SelectedWork currentLang="id" />

  <!-- 04 EXPERTISE & TECHNOLOGIES (4 organized categories) -->
  <ExpertiseTech currentLang="id" />

  <!-- 05 ABOUT (Concise editorial under 100 words) -->
  <AboutEditorial currentLang="id" />

  <!-- 06 CONTACT (Direct brutalist contact channels) -->
  <ContactCta currentLang="id" />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import HeroSection from '../sections/HeroSection.astro';
import AboutSection from '../sections/AboutSection.astro';
import ExpertiseSection from '../sections/ExpertiseSection.astro';
import SelectedWorkSection from '../sections/SelectedWorkSection.astro';
import InfrastructureSection from '../sections/InfrastructureSection.astro';
import TechStackSection from '../sections/TechStackSection.astro';
import ExperienceSection from '../sections/ExperienceSection.astro';
import ServicesSection from '../sections/ServicesSection.astro';
import NotesSection from '../sections/NotesSection.astro';
import ContactSection from '../sections/ContactSection.astro';
const siteUrl = 'https://rain07.my.id';

const homepageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'RAIN07',
      description: 'Web Developer & Infrastructure Engineer Portfolio',
      inLanguage: 'en-US'
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Reyno Fahreza',
      alternateName: ['RAIN07', 'REYNO07'],
      jobTitle: 'Web Developer & Infrastructure Engineer',
      url: siteUrl,
      sameAs: [
        'https://www.linkedin.com/in/reyno-nur-fahreza-85908999/'
      ],
      knowsAbout: [
        'Web Development',
        'WordPress',
        'Elementor Pro',
        'Laravel',
        'PHP',
        'Astro',
        'TypeScript',
        'Linux Administration',
        'Cloudflare Workers',
        'Networking',
        'IT Infrastructure'
      ]
    }
  ]
};
---

<BaseLayout
  title="RAIN07 — Web Developer & Infrastructure Engineer"
  description="Reyno Fahreza (RAIN07) is a Web Developer & Infrastructure Engineer working across WordPress, Laravel, Linux infrastructure, cloud deployment, and technical systems."
  canonical="/"
  ogType="website"
  jsonLd={homepageJsonLd}
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Dynamic Marquee Bar -->
  <Marquee text="RAIN07 · WEB DEVELOPER · INFRASTRUCTURE ENGINEER · CLOUDFLARE WORKERS · LINUX · LARAVEL · ASTRO" />

  <!-- 01 About Section -->
  <AboutSection />

  <!-- 02 Expertise Section -->
  <ExpertiseSection />

  <!-- 03 Selected Work Section (Dynamic WordPress CPT) -->
  <SelectedWorkSection />

  <!-- 04 Infrastructure Blueprint -->
  <InfrastructureSection />

  <!-- 05 Technology Stack Inventory -->
  <TechStackSection />

  <!-- 06 Experience & Roles -->
  <ExperienceSection />

  <!-- 07 Services Editorial List -->
  <ServicesSection />

  <!-- 08 Technical Notes (Dynamic WordPress Posts) -->
  <NotesSection />

  <!-- 09 Contact Section -->
  <ContactSection />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SystemState from '../components/SystemState.astro';
---

<BaseLayout
  title="404 — Page Not Found // RAIN07"
  description="The requested resource does not exist in the RAIN07 site manifest."
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-20">
    <SectionLabel index="00 // ERROR" title="PAGE NOT FOUND" />

    <SystemState
      statusCode="404"
      statusType="NOT FOUND"
      systemName="RAIN07"
      subtitle="PAGE NOT FOUND"
      title="PAGE NOT FOUND."
      description="The page you are looking for does not exist or has been moved."
      technicalMessage="The requested URL was not found on this server."
      primaryAction={{
        label: "← BACK TO HOME",
        href: "/",
        variant: "primary"
      }}
      secondaryAction={{
        label: "SELECTED WORK →",
        href: "/work",
        variant: "secondary"
      }}
      tertiaryAction={{
        label: "TECHNICAL NOTES →",
        href: "/notes",
        variant: "secondary"
      }}
    />
  </div>
</BaseLayout>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SystemState from '../components/SystemState.astro';
---

<BaseLayout
  title="404 — Page Not Found // RAIN07"
  description="The requested resource does not exist in the RAIN07 site manifest."
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-20">
    <SectionLabel index="00 // ROUTING" title="SYSTEM DISPATCH" />

    <SystemState
      statusCode="404"
      statusType="NOT FOUND"
      systemName="RAIN07 // EDGE ROUTER"
      subtitle="RESOURCE MISSING"
      title="PAGE NOT FOUND."
      description="The page, project, or technical note you are looking for does not exist in the route manifest or has been relocated."
      technicalMessage="Requested URI yielded no corresponding static asset or compiled path in the Cloudflare Workers static route inventory."
      primaryAction={{
        label: "← BACK TO HOME",
        href: "/",
        variant: "primary"
      }}
      secondaryAction={{
        label: "SELECTED WORK →",
        href: "/work",
        variant: "secondary"
      }}
      tertiaryAction={{
        label: "TECHNICAL NOTES →",
        href: "/notes",
        variant: "secondary"
      }}
    />
  </div>
</BaseLayout>


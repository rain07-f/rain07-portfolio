---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SystemState from "../../components/SystemState.astro";
import {
  getPortfolioItems,
  getPortfolioCategories,
} from "../../lib/api/client";

const projects = await getPortfolioItems();
const categories = await getPortfolioCategories();
const siteUrl = "https://rain07.my.id";

const workJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${siteUrl}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Project",
          item: `${siteUrl}/work/`,
        },
      ],
    },
    {
      "@type": "CollectionPage",
      "@id": `${siteUrl}/work/#webpage`,
      url: `${siteUrl}/work/`,
      name: "Hasil Kerja & Project — RAIN07",
      description:
        "Portofolio hasil kerja pengembangan website bisnis, CMS WordPress, dan implementasi sistem IT oleh Reyno Nur Fahreza.",
    },
  ],
};
---

<BaseLayout
  title="Hasil Kerja & Project — RAIN07"
  description="Portofolio hasil kerja pengembangan website bisnis, CMS WordPress, dan implementasi sistem IT oleh Reyno Nur Fahreza."
  canonical="/work/"
  ogType="website"
  locale="id"
  jsonLd={workJsonLd}
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <SectionLabel index="02 // HASIL KERJA" title="SELECTED PROJECTS" />

    <!-- Intro Header -->
    <div
      class="border-2 border-[#111111] bg-[#FFFFFF] p-8 md:p-12 shadow-hard mb-12"
    >
      <div class="max-w-3xl space-y-4">
        <span
          class="font-mono text-xs font-bold px-2 py-1 bg-[#0057FF] text-[#FFFFFF]"
        >
          LIVE DATA STREAM // WORDPRESS CPT
        </span>
        <h1
          class="text-3xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight text-[#111111]"
        >
          HASIL KERJA & PROJECT
        </h1>
        <p
          class="font-mono text-sm md:text-base text-[#111111]/80 leading-relaxed"
        >
          Kumpulan website bisnis, implementasi aplikasi web, dan infrastruktur
          IT nyata yang telah diselesaikan.
        </p>
      </div>

      <!-- Categories Filter bar -->
      {
        categories.length > 0 && (
          <div class="mt-8 pt-6 border-t-2 border-[#111111]/20 flex flex-wrap items-center gap-2 font-mono text-xs">
            <span class="font-bold text-[#111111] mr-2">KATEGORI:</span>
            <span class="px-2 py-1 bg-[#111111] text-[#F2F0EA] font-semibold">
              SEMUA ({projects.length})
            </span>
            {categories.map((cat) => (
              <span class="px-2 py-1 border border-[#111111] bg-[#F2F0EA] text-[#111111] font-semibold">
                {cat.name}
              </span>
            ))}
          </div>
        )
      }
    </div>

    <!-- Projects Grid -->
    {
      projects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {projects.map((project, idx) => (
            <div
              class={`reveal-item flex flex-col ${idx === 0 ? "md:col-span-2" : ""}`}
              style={`--stagger: ${idx % 3};`}
            >
              <ProjectCard
                project={project}
                featured={idx === 0}
                currentLang="id"
              />
            </div>
          ))}
        </div>
      ) : (
        <SystemState
          class="reveal-item"
          statusCode="EMPTY"
          statusType="WORK ARCHIVE"
          systemName="RAIN07 // ARCHIVE"
          subtitle="NO PROJECTS FOUND"
          title="ARSIP PROJECT KOSONG"
          description="Saat ini belum ada case study proyek yang dipublikasikan. Proyek dan sistem baru akan segera muncul di sini."
          technicalMessage="REST query /wp-json/wp/v2/portfolio returned 0 records."
          primaryAction={{
            label: "← KEMBALI KE BERANDA",
            href: "/",
            variant: "primary",
          }}
          secondaryAction={{
            label: "BACA CATATAN TEKNIS →",
            href: "/notes",
            variant: "secondary",
          }}
        />
      )
    }
  </div>
</BaseLayout>
